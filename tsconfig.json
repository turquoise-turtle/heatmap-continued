{
    "compilerOptions": {
        "target": "es2017",
        "lib": ["es2020", "dom", "dom.iterable"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "types": ["node"]
    },
    "include": ["web/**/*.ts"]
}
